{
  "expo": {
    "name": "Expense Tracker",
    "slug": "expense-tracker-app",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.expensetracker.mobile"
    },
    "android": {
      "package": "com.expensetracker.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A"
      }
    },
    "extra": {
      "eas": {
        "projectId": "d8fe8040-239d-4369-84c8-1859c7a3c6b9"
      }
    },
    "owner": "kamrul377",
    "plugins": [
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Expense Tracker to use Face ID."
        }
      ],
      "expo-secure-store"
    ]
  }
}