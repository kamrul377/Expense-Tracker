{
  "expo": {
    "name": "Expense Tracker",
    "slug": "expense-tracker-app",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "scheme": "expensetracker",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.expensetracker.mobile"
    },
    "android": {
      "package": "com.expensetracker.mobile",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A"
      }
    },
    "extra": {
      "eas": {
        "projectId": "d8fe8040-239d-4369-84c8-1859c7a3c6b9"
      }
    },
    "owner": "kamrul377",
    "plugins": [
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Expense Tracker to use Face ID."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#10B981"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Expense Tracker to record the places you visit, even when the app is closed.",
          "locationWhenInUsePermission": "Allow Expense Tracker to record the places you visit.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ]
    ]
  }
}